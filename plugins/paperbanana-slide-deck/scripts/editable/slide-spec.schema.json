{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deck", "slides"],
  "$defs": {
    "element": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "x", "y", "w", "h"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "type": { "enum": ["text", "shape", "line", "table", "chart", "image", "group"] },
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "w": { "type": "number", "minimum": 0 },
        "h": { "type": "number", "minimum": 0 },
        "text": { "type": "string" },
        "font_size": { "type": "number", "minimum": 16 },
        "color": { "type": "string", "pattern": "^[0-9A-F]{6}$" },
        "align": { "enum": ["left", "center", "right"] },
        "valign": { "enum": ["top", "middle", "bottom"] },
        "bold": { "type": "boolean" },
        "shape": { "type": "string" },
        "fill": { "type": "string", "pattern": "^[0-9A-F]{6}$" },
        "stroke": { "type": "string", "pattern": "^[0-9A-F]{6}$" },
        "rows": { "type": "array" },
        "chart_type": { "enum": ["bar", "line", "scatter"] },
        "series": { "type": "array" },
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "alt_text": { "type": "string" },
        "end_arrow": { "enum": ["none", "triangle", "stealth", "arrow"] },
        "children": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/element" } }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "1" },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "language", "theme"],
      "properties": {
        "layout": { "const": "LAYOUT_WIDE" },
        "language": { "enum": ["en", "zh-CN"] },
        "theme": { "enum": ["paperbanana-parchment", "paperbanana-clean"] }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "speaker_notes", "sources", "elements"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "speaker_notes": { "type": "string", "minLength": 1 },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "elements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/element" } }
        }
      }
    }
  }
}
